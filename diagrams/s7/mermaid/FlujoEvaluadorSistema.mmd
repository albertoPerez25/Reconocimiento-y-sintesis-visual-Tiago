---
config:
  look: classic
---
sequenceDiagram
    participant Terminal as Terminal / Usuario
    participant E as SystemEvaluatorNode
    participant R as Lógica: LLMReporterNode
    participant V as Nodo: PerceptionNode
    participant Ragas as RagasEvaluator
    participant O@{ "type": "entity" } as Ollama API
    participant Disco@{ "type": "database" } as Disco Local

    Note over Terminal, Disco: Fase Inicial: El usuario inicia perceptores y evaluador
    
    Terminal->>E: Service Call: /evaluate_patrol_system [Mode]
    
    %% --- CAMBIO: Aclaración del Mock (Inyección de dependencias) ---
    E->>E: Instancia MockGoalHandle (Aísla Action Server) y Result
    
    rect rgb(240, 248, 255)
        opt Si Mode != 'evaluate_only'
            Note right of E: Fase 1: Extracción de Contexto Visual
            E->>R: validate_data(eval_folder_path, mock_result)
            R->>Disco: Lee metadata.csv e imágenes del test_dataset
            
            E->>R: process_each_image(zone_groups)
            loop Por cada zona e imagen/secuencia del dataset
                R->>V: Llama /analyze_image(path, Contexto RAG)
                %% --- CAMBIOS: Uso de interfaces segregadas ---
                alt BasePositionPerceptionNode (Ej: YOLO)
                    V->>V: Inferencia local de posiciones/cajas
                else BaseVLMPerceptionNode (Ej: Moondream, Video, Híbrido)
                    V->>O: Inferencia visual con contexto inyectado
                    O-->>V: JSON descriptivo
                end
                %% ---------------------------------------------
                V-->>R: Retorna JSON {descripcion, alerta}
            end
            R-->>E: Devuelve global_context_json
        end
    end
    
    alt Si Mode == 'evaluate_only'
        E->>Disco: Lee /tmp/ragas_intermediate_answers.json
    else Si Mode == 'full' OR Mode == 'generate_only'
        %% --- CAMBIO: Ragas interactúa con VectorManager ---
        E->>Ragas: generate_answers(vector_manager, global_context_json)
        %% --------------------------------------------------
        E->>Disco: Guarda Savepoint: ragas_intermediate_answers.json
    end
    
    rect rgb(255, 245, 238)
        Note right of E: Fase 2: Evaluación Ragas
        opt Si Mode != 'generate_only'   
            E->>Ragas: evaluate_system()

            Ragas->>Disco: Lee quest.json (Preguntas y Ground Truth)
            
            loop Por cada pregunta en quest.json
                Ragas->>O: Prompt + pregunta y contexto extraído del FAISS
                O-->>Ragas: Respuesta generada por LLM Juez
            end
            
            Ragas->>O: ragas.evaluate() (HuggingFace Dataset)
            %% --- CAMBIO: Métricas exclusivas SOTA RAG ---
            O-->>Ragas: Retorna métricas (context_precision, context_recall, answer_relevancy, faithfulness)
            %% ---------------------------------------------
            
            Ragas->>Disco: Guarda ragas_system_*.csv
        end
    end
