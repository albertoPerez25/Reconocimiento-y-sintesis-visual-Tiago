---
config:
  look: neo
---
classDiagram
    class BaseReporterNode {
        <<abstract>>
        +semantic_map: dict
        +metrics: dict
        +hospital_metadata: dict
        +metadata_path: str
        +report_action_server: ActionServer
        +execute_report_callback(goal_handle)*
        +get_zone_name(x, y)
        +get_images_grouped_by_zone(photos_dir)
        +save_metrics()
        +load_hospital_metadata()
        +get_zone_metadata(zone_name)
    }
    
    class LLMReporterNode {
        +perception_mode: str
        +vision_cli: Client
        +execute_report_callback(goal_handle)
        +process_each_image(zone_groups, goal_handle, result)
        +generate_global_summary(global_context, result)
    }
    
    BaseReporterNode <|-- LLMReporterNode
    
    class BaseEvaluatorNode {
        <<abstract>>
        +ollama_params: OllamaParams
        +run_params: EvaluatorRunParams
    }

    class SystemEvaluatorNode {
        +reporter_logic: LLMReporterNode
        +ragas_evaluator: RagasEvaluator
        +metrics_dir: str
        +evaluate_callback(req, res)
    }

    class PerceptionEvaluatorNode {
        +vision_cli: Client
        +ragas_evaluator: RagasEvaluator
        +metrics_dir: str
        +evaluate_callback(req, res)
    }

    BaseEvaluatorNode <|-- SystemEvaluatorNode
    BaseEvaluatorNode <|-- PerceptionEvaluatorNode
    SystemEvaluatorNode *-- LLMReporterNode
    SystemEvaluatorNode *-- RagasEvaluator
    PerceptionEvaluatorNode *-- RagasEvaluator

    class MockGoalHandle {
        +is_cancel_requested: bool
        +publish_feedback(msg)
    }
    SystemEvaluatorNode ..> MockGoalHandle : Instancia

    class RagasEvaluator {
        +quest_path: str
        +metrics_dir: str
        +evaluator_llm: ChatOllama
        +evaluator_embeddings: OllamaEmbeddings
        +evaluate_system(global_context_json)
        +generate_answers(global_context_json)
        +evaluate_perception(perception_data, model_name)
        +generate_perception_answers(perception_data)
    }

    class OllamaParams {
        +ollama_url: str
        +evaluator_llm_model: str
        +evaluator_embed_model: str
    }

    class EvaluatorRunParams {
        +system_workers: int
        +system_timeout: int
        +perceptors_workers: int
        +perceptors_timeout: int
    }

    RagasEvaluator --> OllamaParams : Configura con
    RagasEvaluator --> EvaluatorRunParams : Configura con
    
    class PatrolNode {
        +base_photos_dir: str
        +current_folder_path: str
        +report_action_client: ActionClient
        +param_client: Client
        +active_goal_handle
        +set_capturer_folder(folder_path)
        +trigger_report()
        +goal_response_callback(...)
        +report_feedback_callback(...)
        +get_result_callback(...)
        +navigate_to_waypoint(...)
        +run_patrol()
    }
    
    class PhotoCapturerNode {
        +current_dir: str
        +parameters_callback(params)
        +setup_directory()
        +save_photo(cv_image)
        +save_metadata(image_name)
    }

    class Utils_Modules {
        <<utility>>
        +load_route(...)
        +list_to_pose(...)
        +clean_all_orphan_folders(...)
        +get_next_available_folder(...)
        +delete_folder(...)
        +get_key_non_blocking()
    }
    PatrolNode ..> Utils_Modules : Usa
    
    class RagContext {
        +zone_name: str
        +time_str: str
        +expected_activities: str
        +zone_type: str
        +tracking_history: str
    }

    class BasePerceptionNode {
        <<abstract>>
        +analyze_callback(req, res)
        +process_image(image_path, context)*
        +check_path(path)*
    }
    
    class VLMPerceptionNode {
        +vlm_model: str
        +ollama_url: str
        +process_image(image_path, context)
    }
    
    class YoloPerceptionNode {
        +model: YOLO
        +process_image(image_path, context)
    }
    
    class HybridPerceptionNode {
        +yolo_logic: YoloPerceptionNode
        +vlm_logic: VLMPerceptionNode
        +tracking_memory: dict
        +process_image(image_path, context)
    }
    
    class SequencePerceptionNode {
        +process_image(image_paths_str, context)
    }
    
    BasePerceptionNode ..> RagContext : Recibe
    BasePerceptionNode <|-- VLMPerceptionNode
    BasePerceptionNode <|-- YoloPerceptionNode
    BasePerceptionNode <|-- HybridPerceptionNode
    BasePerceptionNode <|-- SequencePerceptionNode
