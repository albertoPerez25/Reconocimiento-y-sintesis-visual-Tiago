config:
  layout: elk
  theme: redux
---
flowchart TB
 subgraph Sensores["Sensores"]
        Cam[/"Topic: /head_front_camera/rgb/image_raw"/]
        Odom[/"Topic: /odom"/]
  end
 subgraph Sistema_ROS2_Hospital["Sistema_ROS2_Hospital"]
        Photo["Nodo: photo_capturer"]
        Patrol["Nodo: patrol_node"]
        Reporter["Nodo: llm_reporter_node"]
        Perceptor["Nodo: hybrid_perception_node"]
        Evaluator["Nodo: system_evaluator_node"]
  end
    Cam --> Photo
    Odom --> Photo
    
    Patrol -- "Service: SetParameters (current_save_dir)" --> Photo
    Photo -- "Guarda fotos y CSV en subcarpetas (vuelta_X) si distancia > 1.0m y MSE > umbral" --> Disco[("Disco Local<br>Metadata.csv + JPGs")]

    Patrol -- Action: /generate_patrol_report --> Reporter
    Patrol -- "Crea y borra carpetas de vuelta_X dinámicamente (búfer circular)" --> Disco
    Patrol -. Service: /evaluate_patrol_system .-> Evaluator
    
    Reporter -- Lee datos de vuelta_X --> Disco
    Reporter -- Service: /analyze_image<br>(foto a foto o secuencia) --> Perceptor
    Reporter -- Genera<br>Síntesis Final (Llama3) --> Ollama(("Ollama API Local<br>http://localhost:11434"))
    
    Evaluator -- Usa lógica interna --> Reporter
    Evaluator -- Evalúa respuestas (RAGAS) --> Ollama
    Evaluator -- "Lee preguntas (quest.json) Guarda métricas (ragas_*.csv)" --> Disco

    Perceptor -- "Lógica interna (YOLO26n-pose)" --> Perceptor
    Perceptor -- Analiza<br>contexto visual (Moondream) --> Ollama

     Photo:::ros
     Patrol:::ros
     Reporter:::ros
     Perceptor:::ros
     Evaluator:::ros
     Ollama:::api
    classDef ros fill:#e1f5fe,stroke:#01579b,stroke-width:2px
    classDef api fill:#fff3e0,stroke:#e65100,stroke-width:2px
