---
config:
  layout: elk
  theme: redux
---
flowchart TB
 subgraph Sensores["Sensores"]
        Cam[/"Topic: /head_front_camera/rgb/image_raw"/]
        Odom[/"Topic: /odom"/]
  end
 subgraph Sistema_ROS2_Hospital["Sistema_ROS2_Hospital"]
        Photo["Nodo: photos_capturer_node"]
        VideoCap["Nodo: video_capturer_node"]
        Patrol["Nodo: patrol_node"]
        Reporter["Nodo: llm_reporter_node"]
        Perceptor["Nodos de Percepción<br>(Hybrid, Video, Seq)"]
        SysEval["Nodo: system_evaluator_node"]
        PercEval["Nodo: perception_evaluator_node"]
        Chatbot["Nodo: patrol_chatbot_node"]
  end

    %% Conexiones de Sensores y Captura
    Cam --> Photo & VideoCap
    Odom --> Photo & VideoCap
    Patrol -- "SetParameters" --> Photo & VideoCap
    Photo & VideoCap -- "Escritura de datos (vuelta_X)" --> Disco[("Disco Local<br>Multimedia, Semantic Map, Datasets<br>y Hospital Metadata")]

    %% Interacciones del Usuario
    Usuario(("Usuario")) -. "Inicia el sistema" .-> Patrol
    Usuario -. "Consulta de incidencias" .-> Chatbot
    Usuario -. "Evaluar sistema completo:\nService: /evaluate_patrol_system\n[generate_only / evaluate_only / full]" .-> SysEval
    Usuario -. "Evaluar sólo visión:\nService: /evaluate_perception_model" .-> PercEval

    %% Flujo de Patrulla Principal
    Patrol -- Action: /generate_patrol_report --> Reporter
    Reporter -- "Lee datos de vuelta_X y hospital_metadata.json (RAG)" --> Disco
    Reporter -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    Reporter -- Genera Síntesis Final (Llama3) --> Ollama(("Ollama API Local<br>http://localhost:11434"))
    Reporter -- "Actualiza Contexto" --> ContextFile[("latest_patrol_context.json")]

    %% Lógica de Percepción (Combinada)
    Perceptor -- "Lógica interna (YOLO26n-pose)" --> Perceptor
    Perceptor -- Analiza contexto visual (Moondream) --> Ollama
    Perceptor -- "Tracking e Inferencia Visual" --> Ollama

    %% Flujo del Chatbot
    Chatbot -. Service: /get_patrol_context .-> Reporter
    Chatbot -- "RAG sobre registros" --> ContextFile
    Chatbot -- "Responde dudas" --> Ollama

    %% Flujo de Evaluación de Sistema
    SysEval -- Instancia y usa lógica interna --> Reporter
    SysEval -- Evalúa respuestas (RAGAS) --> Ollama
    SysEval -- "Savepoint: ragas_intermediate_answers.json\nLee quest.json y Guarda ragas_system_*.csv" --> Disco

    %% Flujo de Evaluación de Percepción
    PercEval -- "Lee perception_dataset.json, test_dataset y guarda ragas_eval_*.csv" --> Disco
    PercEval -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    PercEval -- Evalúa agudeza visual (RAGAS) --> Ollama

    %% Estilos
     Photo:::ros
     VideoCap:::ros
     Patrol:::ros
     Reporter:::ros
     Perceptor:::ros
     SysEval:::ros
     PercEval:::ros
     Chatbot:::ros
     Ollama:::api
    classDef ros fill:#e1f5fe,stroke:#01579b,stroke-width:2px
    classDef api fill:#fff3e0,stroke:#e65100,stroke-width:2px
