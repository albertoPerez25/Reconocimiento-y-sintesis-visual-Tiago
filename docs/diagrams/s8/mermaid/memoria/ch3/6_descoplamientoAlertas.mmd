flowchart TB
    %% --- NÚCLEO ROBÓTICO ---
    subgraph Nucleo ["Núcleo de Control Crítico (Robot)"]
        Orq["Orquestador Cognitivo\n(Proceso ininterrumpido)"]
    end

    %% --- BARRERA LÓGICA (BASES DE DATOS) ---
    subgraph Barrera ["Barrera Lógica de Aislamiento"]
        Mem[("Almacenamiento Compartido\n(Memoria Vectorial y Disco Local)")]
    end

    %% --- CAPA DE PRESENTACIÓN ---
    subgraph Exterior ["Capa de Presentación y Reacción (Subprocesos independientes)"]
        UI(("Interfaz Gráfica\n(Web interactiva)"))
        Alerta["Módulo de Alerta\n(Notificaciones del Sistema Operativo)"]
    end

    %% --- CONEXIONES DE ESCRITURA Y EMPUJE ---
    Orq -- "Escritura continua de\nmarcas de tiempo y resúmenes" --> Mem
    Orq -- "Reacción Activa: Empuje asíncrono\nde emergencias" --> Alerta

    %% --- CONEXIONES DE LECTURA (POLLING) ---
    UI -. "Lectura Pasiva (Polling):\nMonitoriza cambios sin\ninterrumpir ni bloquear al robot" .-> Mem

    %% --- ESTILOS PASTEL ---
    classDef core fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
    classDef barrier fill:#E5D8BD,stroke:#333,stroke-width:2px,color:#333,stroke-dasharray: 5 5;
    classDef ui fill:#CCEBC5,stroke:#333,stroke-width:1px,color:#333;
    classDef alert fill:#FBB4AE,stroke:#333,stroke-width:1px,color:#333;

    Orq:::core
    Mem:::barrier
    UI:::ui
    Alerta:::alert
