---
config:
  layout: elk
---
flowchart TB
    %% FASE 1: PRODUCCIÓN
    subgraph Fase1 ["Fase 1: Inferencia de Producción (Alta carga de VRAM)"]
        Orq["Orquestador Cognitivo\n(Sistema bajo evaluación)"]
        Transparencia["Mecanismo de Transparencia\n(Exposición de procesos internos)"]
        
        Orq -- "Simula respuestas a\npreguntas de control" --> Transparencia
    end

    %% ESTADO INTERMEDIO (SAVEPOINT)
    subgraph Savepoint ["Estado Intermedio Seguro (Savepoint en Disco)"]
        direction LR
        P1[/"1. Pregunta\nFormulada"/]
        P2[/"2. Contexto Exacto\nRecuperado (FAISS)"/]
        P3[/"3. Respuesta Final\nGenerada (LLM)"/]
    end

    %% FASE 2: ARBITRAJE
    subgraph Fase2 ["Fase 2: Arbitraje Algorítmico (Aislamiento anti-OOM)"]
        Juez["Juez Evaluador\n(Auditor independiente)"]
        Metricas["Métricas Objetivas Finales\n(Exactitud, Relevancia y Fidelidad)"]
    end

    %% CONEXIONES ENTRE FASES
    Transparencia -- "Escribe datos para\nevitar su pérdida" --> P1 & P2 & P3
    
    P1 & P2 & P3 -- "Lectura del disco" --> Juez
    
    Juez -- "Audita si la respuesta 3\nse inventó datos no presentes en el contexto 2" --> Metricas

    %% ESTILOS PASTEL
    classDef process fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
    classDef data fill:#E5D8BD,stroke:#333,stroke-width:1px,color:#333;
    classDef savepoint fill:#CCEBC5,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5,color:#333;
    classDef judge fill:#FBB4AE,stroke:#333,stroke-width:1px,color:#333;
    classDef metric fill:#FED9A6,stroke:#333,stroke-width:1px,color:#333;

    Orq:::process
    Transparencia:::process
    P1:::data
    P2:::data
    P3:::data
    Juez:::judge
    Metricas:::metric
