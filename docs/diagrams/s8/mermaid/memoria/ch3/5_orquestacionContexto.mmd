---
config:
  layout: elk
---
flowchart LR
    %% --- FLUJO DE INGESTA ---
    subgraph Ingesta ["Flujo de Ingesta (Tiempo Real)"]
        direction TB
        Evento["Eventos del Entorno\n(Observaciones continuas)"]
        Index["Indexación Dinámica\n(Transformación al vuelo)"]
        Evento --> Index
    end

    %% --- NÚCLEO DE MEMORIA ---
    VS[("Memoria Vectorial\n(Base de datos efímera)")]

    %% --- FLUJO DE CONSULTA ---
    subgraph Consulta ["Flujo de Consulta (Interactivo)"]
        direction TB
        User(("Usuario"))
        Bufer["Búfer a Corto Plazo\n(Reformulación de la pregunta)"]
        Recup{"Recuperador Híbrido\n(Filtra por Texto y Metadatos\npara evitar alucinaciones)"}
        
        User --> Bufer
        Bufer --> Recup
    end

    %% --- MOTOR GENERATIVO aisaldo ---
    LLM["Modelo Generativo (LLM)"]

    %% --- CONEXIONES CENTRALES ---
    Index -- "Almacena representaciones" --> VS
    Recup -- "Extrae únicamente lo relevante" --> VS
    
    VS -- "Inyecta Contexto Exacto" --> LLM
    LLM -- "Genera respuesta\nbasada en evidencias" --> User

    %% --- ESTILOS PASTEL ---
    classDef process fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
    classDef decision fill:#FED9A6,stroke:#333,stroke-width:1px,color:#333;
    classDef memory fill:#E5D8BD,stroke:#333,stroke-width:1px,color:#333,stroke-dasharray: 5 5;
    classDef llm fill:#FBB4AE,stroke:#333,stroke-width:1px,color:#333;
    classDef user fill:#CCEBC5,stroke:#333,stroke-width:1px,color:#333;

    Evento:::process
    Index:::process
    VS:::memory
    Bufer:::process
    Recup:::decision
    LLM:::llm
    User:::user
