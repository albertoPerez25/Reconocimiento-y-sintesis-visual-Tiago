---
config:
  layout: elk
---
flowchart TB
    subgraph Nivel_Superior ["Capa Superior: Lógica Central"]
        Orq["Orquestador Central\n(Agnóstico a la tecnología de percepción)"]
    end

    subgraph Nivel_Intermedio ["Capa Intermedia: Unidades Cognitivas"]
        InterfazPerc{{"Interfaz Abstracta\nde Percepción"}}
        ModGeo["Modelo\nEstrictamente Geométrico"]
        ModVLM["Modelo\nVisión-Lenguaje (VLM)"]
        ModHib["Modelo\nde Percepción Híbrida"]
        
        InterfazPerc -. "Implementa" .-> ModGeo
        InterfazPerc -. "Implementa" .-> ModVLM
        InterfazPerc -. "Implementa" .-> ModHib
    end

    subgraph Nivel_Inferior ["Capa Inferior: Adquisición de Datos"]
        InterfazCap{{"Interfaz Abstracta\nde Captura Física"}}
        CapEstatica["Flujo Estático\n(Fotografías)"]
        CapSecuencial["Flujo\nSecuencial"]
        CapVideo["Flujo Continuo\n(Vídeo)"]
        
        InterfazCap -. "Implementa" .-> CapEstatica
        InterfazCap -. "Implementa" .-> CapSecuencial
        InterfazCap -. "Implementa" .-> CapVideo
    end

    %% CONEXIONES
    Orq -- "Delega la evaluación visual\nmediante polimorfismo" --> InterfazPerc
    ModGeo & ModVLM & ModHib -- "Consumen los archivos generados" --> InterfazCap

    %% ESTILOS PASTEL
    classDef core fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
    classDef abstract fill:#E5D8BD,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5,color:#333;
    classDef model fill:#FED9A6,stroke:#333,stroke-width:1px,color:#333;
    classDef capture fill:#CCEBC5,stroke:#333,stroke-width:1px,color:#333;

    Orq:::core
    InterfazPerc:::abstract
    InterfazCap:::abstract
    ModGeo:::model
    ModVLM:::model
    ModHib:::model
    CapEstatica:::capture
    CapSecuencial:::capture
    CapVideo:::capture
