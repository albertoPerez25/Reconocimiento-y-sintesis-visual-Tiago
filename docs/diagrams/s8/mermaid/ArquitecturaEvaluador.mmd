config:
  layout: elk
  theme: redux
---
flowchart TB
 subgraph Sistema_ROS2_Hospital["Sistema_ROS2_Hospital"]
        
        subgraph Produccion["Producción"]
            Reporter["Nodo: llm_reporter_node"]
            Perceptor["Nodos de Percepción<br>(Hybrid, Video, Seq)"]
        end
        
        subgraph Subsistema_Validacion_Arbitraje["Subsistema de Validación y Arbitraje"]
            SysEval["Nodo: system_evaluator_node"]
            PercEval["Nodo: perception_evaluator_node"]
        end
        
  end

    Usuario(("Usuario")) -. "Evaluar sistema completo:\nAction: /evaluate_patrol_system\n[generate_only / evaluate_only / full]" .-> SysEval
    Usuario -. "Evaluar sólo visión:\nAction: /evaluate_perception_model" .-> PercEval
    
    Reporter -- "Lee datos de vuelta y hospital_metadata.json (RAG)" --> Disco[("Disco Local<br>Metadatos, Datasets y Fotos")]
    Reporter -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    Reporter -- Genera Síntesis Final (Llama3) --> Ollama(("Ollama API Local<br>http://localhost:11434"))
    
    SysEval -- Instancia y usa lógica interna --> Reporter
    
    %% Especificación del flujo de evaluación RAGAS, transparencia y métricas
    SysEval -- "Extrae fragmentos exactos" --> VectorStore[("VectorManager<br>(LangChain/FAISS)")]
    SysEval -- "Inyecta fragmentos exactos como<br>Ground Truth Context (Transparencia)" --> Ollama
    SysEval -- "Evalúa LLM (Answer Correctness/Relevancy, Summarization)<br>y FAISS (Context Prec/Rec/Entity Recall)" --> Ollama
    %% ------------------------------------------------------------------------
    
    %% Desacoplamiento mediante Estados Intermedios 
    SysEval <-->|"Escribe (generate) / Lee (evaluate) Savepoint:<br>ragas_intermediate_answers.json (Escudo anti-OOM)"| Disco
    SysEval -- "Lee quest.json y Guarda ragas_system_*.csv" --> Disco

    PercEval -- "Lee perception_dataset.json, test_dataset y guarda ragas_eval_*.csv" --> Disco
    PercEval -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    
    %% Aclaradas las métricas de percepción aislada
    PercEval -- "Evalúa agudeza visual (Faithfulness exclusiva)" --> Ollama
    
    Perceptor -- "Tracking e Inferencia Visual" --> Ollama

     Reporter:::ros
     Perceptor:::ros
     SysEval:::ros
     PercEval:::ros
     Ollama:::api

     %% Estilos Pastel 
     classDef ros fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
     classDef api fill:#FBB4AE,stroke:#333,stroke-width:1px,color:#333;
