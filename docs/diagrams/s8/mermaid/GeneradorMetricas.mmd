flowchart LR
    %% Script independiente de pre-procesamiento
    Raw[(Tiempos crudos:\n*_metrics.json)] --> AggScript[aggregate_perception_metrics.py]

    subgraph "Entradas de Datos (Generados por los nodos)"
        M1[(comparativa_modelos.json Latencias y Verbosidad)]
        %% --- CAMBIO: Actualizado texto descriptivo de las métricas RAGAS ---
        M2[(ragas_*.csv Metrics: Context Precision/Recall, Faithfulness...)]
        %% --- CAMBIO: Inclusión de los archivos agregados ---
        M3[(aggregated_*_metrics.json Evaluación de Tiempos)]
    end
    
    AggScript --> M3

    subgraph "generate_metrics.py (Procesamiento)"
        P1[load_performance_data]
        P2[load_ragas_data]
        %% --- CAMBIO: Nuevo cargador de datos ---
        P4[load_aggregated_perception_data]
        P3[Pandas: Agrupación por Eval_Category]
        
        M1 --> P1
        M2 --> P2
        M3 --> P4
        P1 & P2 & P4 --> P3
    end

    subgraph "Salidas"
        C1[1_performance_summary.csv]
        C2[2_ragas_summary.csv]
        G1{{"5_grafica_comparativa_ragas.png\n(Sistema)"}}
        G2{{"6_grafica_ragas_percepcion.png\n(Percepción aislada)"}}
        G3{{"Gráficos 3 y 4:\nBarras y Boxplots de Rendimiento"}}
        %% --- CAMBIOS: Nuevas salidas visuales de percepción ---
        G4{{"7_percepcion_latencia_extrema.png\n(Media vs P99)"}}
        G5{{"8_percepcion_fps.png\n(Conversión a FPS)"}}
        G6{{"9_hibrido_cuello_botella.png\n(Ahorro Early Exit)"}}
        
        P3 --> C1 & C2
        P3 --> G1 & G2 & G3 & G4 & G5 & G6
    end
