---
config:
  layout: elk
  theme: redux
---
flowchart TB
    %% DEFINICIÓN DE ENTIDADES EXTERNAS Y NODOS ESPECIALES 
    Disco[("Disco Local<br>Multimedia, Semantic Map<br>y Hospital Metadata")]
    SO[/"Sistema Operativo"/]
    FAISS[("VectorStore (FAISS)<br>/tmp/ruta_hospital_rag_data/")]
    ChatbotWeb(("Frontend Streamlit<br>ChatbotWeb"))
    Ollama(("Ollama API Local<br>Puerto: 11434"))
    Usuario(("Usuario"))

    subgraph Sensores["Sensores"]
        Cam[/"Topic: /head_front_camera/rgb/image_raw"/]
        Odom[/"Topic: /odom"/]
    end

    subgraph Sistema_ROS2_Hospital["Sistema_ROS2_Hospital"]
        
        subgraph Capturadores["Capturadores"]
            Photo["Nodo: photos_capturer_node"]
            VideoCap["Nodo: video_capturer_node"]
        end

        subgraph Navegador["Navegador"]
            Patrol["Nodo: patrol_node"]
        end

        subgraph Perceptores["Perceptores"]
            Perceptor["Nodos de Percepción<br>(Hybrid, Video, Seq)"]
            EarlyExit{"¿Despejado?<br>(Early Exit)"}
        end

        subgraph Orquestador["Orquestador"]
            Reporter["Nodo: llm_reporter_node"]
        end

        subgraph Alerta["Alerta"]
            AlarmNode["Nodo: alarm_notifier_node"]
        end

        subgraph Evaluadores["Evaluadores"]
            EvalNodes["Nodos: system_evaluator_node<br>perception_evaluator_node"]
        end

    end

    %% FLUJO DE DATOS Y CONEXIONES
    Cam --> Photo & VideoCap
    Odom --> Photo & VideoCap
    
    Patrol -- "SetParameters" --> Photo & VideoCap
    Photo & VideoCap -- "Escritura de datos (vuelta_X)" --> Disco
    
    Usuario -. "Inicia el sistema" .-> Patrol
    Patrol -- "Action: /generate_patrol_report" --> Reporter
    
    Reporter -- "Lee datos de vuelta_X y hospital_metadata.json (RAG)" --> Disco
    Reporter -- "Service: /analyze_image<br>+ Contexto RAG" --> Perceptor
    
    %% Cortocircuito Early Exit
    Perceptor -- "Evaluación Geométrica (YOLO)" --> EarlyExit
    EarlyExit -. "Abortar (Despejado)" .-> Reporter
    EarlyExit -- "Análisis Semántico (Moondream o Qwen)" --> Ollama

    Reporter -- "Genera Síntesis Final (Llama3)" --> Ollama
    
    %% Subsistema de Alerta y SO
    Reporter -- "Topic: /hospital/alarms" --> AlarmNode
    AlarmNode -- "Notificaciones visuales emergentes" --> SO

    %% lógica de RAG
    Reporter -- "Inyecta Documentos (VectorManager)" --> FAISS
    
    Usuario -. "Consulta de incidencias" .-> ChatbotWeb
    
    %% Desacoplamiento de Interfaz (Polling) 
    ChatbotWeb -. "Polling<br>marcas de tiempo" .-> FAISS
    ChatbotWeb -. "Polling<br>resúmenes estáticos" .-> Disco
    ChatbotWeb -- "Inferencia interactiva (LangChain)" --> Ollama

    %% ESTILOS
    Photo:::ros
    VideoCap:::ros
    Patrol:::ros
    Reporter:::ros
    Perceptor:::ros
    AlarmNode:::ros
    EvalNodes:::ros
    ChatbotWeb:::web
    Ollama:::api

    classDef ros fill:#B3CDE3,stroke:#333,stroke-width:1px,color:#333;
    classDef web fill:#CCEBC5,stroke:#333,stroke-width:1px,color:#333;
    classDef api fill:#FBB4AE,stroke:#333,stroke-width:1px,color:#333;
    classDef database fill:#FED9A6,stroke:#333,stroke-width:1px,color:#333,stroke-dasharray: 5 5;
