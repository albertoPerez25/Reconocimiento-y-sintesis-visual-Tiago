    Usuario(("Usuario")) -. "Evaluar sistema completo:\nService: /evaluate_patrol_system\n[generate_only / evaluate_only / full]" .-> SysEval
    Usuario -. "Evaluar sólo visión:\nService: /evaluate_perception_model" .-> PercEval
    
    Reporter -- "Lee datos de vuelta y hospital_metadata.json (RAG)" --> Disco[("Disco Local<br>Metadatos, Datasets y Fotos")]
    Reporter -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    Reporter -- Genera Síntesis Final (Llama3) --> Ollama(("Ollama API Local<br>http://localhost:11434"))
    
    SysEval -- Instancia y usa lógica interna --> Reporter
    
    %% --- CAMBIOS: Especificación del flujo de evaluación RAGAS y métricas ---
    SysEval -- "Extrae Contextos" --> VectorStore[("VectorManager<br>(LangChain/FAISS)")]
    SysEval -- "Evalúa (Context Precision/Recall, Faithfulness, Answer Relevancy)" --> Ollama
    %% ------------------------------------------------------------------------
    
    SysEval -- "Savepoint: ragas_intermediate_answers.json\nLee quest.json y Guarda ragas_system_*.csv" --> Disco

    PercEval -- "Lee perception_dataset.json, test_dataset y guarda ragas_eval_*.csv" --> Disco
    PercEval -- "Service: /analyze_image<br>+ Contexto RAG (Zona, Hora, Actividades)" --> Perceptor
    
    %% --- CAMBIO: Aclaradas las métricas de percepción ---
    PercEval -- "Evalúa agudeza visual (Faithfulness, Answer Correctness)" --> Ollama
    
    Perceptor -- "Tracking e Inferencia Visual" --> Ollama

