---
config:
  look: neo
---
classDiagram
    %% --- BLOQUE REPORTERO Y ESTRATEGIAS ---
    class BaseReporterNode {
        <<abstract>>
        +semantic_map: dict
        +metrics: dict
        +hospital_metadata: dict
        +metadata_path: str
        +report_action_server: ActionServer
        +execute_report_callback(goal_handle)*
        +get_zone_name(x, y)
        +get_images_grouped_by_zone(photos_dir)
        +save_metrics()
        +load_hospital_metadata()
        +get_zone_metadata(zone_name)
    }
    
    class LLMReporterNode {
        +perception_mode: str
        +vision_cli: Client
        +perception_strategy: BasePerceptionStrategy
        +recursive_summarizer: RecursiveSummarizer
        %% --- CAMBIO: Atributo añadido por composición ---
        +vector_manager: VectorManager
        +execute_report_callback(goal_handle)
        %% --- CAMBIO: Eliminado +get_context_callback(req, res) ya que LangChain lo maneja ---
        +generate_global_summary(global_context, result)
    }
    
    BaseReporterNode <|-- LLMReporterNode

    class BasePerceptionStrategy {
        <<abstract>>
        +vision_cli: Client
        +reporter: LLMReporterNode
        +get_expected_activities(zone)
        +parse_and_append_event(report, time, zone_data)
        +process(files, zone, zone_data, goal_handle)*
    }

    class ImagePerceptionStrategy { +process(...) }
    class SequencePerceptionStrategy { +process(...) }
    class VideoPerceptionStrategy { +process(...) }

    BasePerceptionStrategy <|-- ImagePerceptionStrategy
    BasePerceptionStrategy <|-- SequencePerceptionStrategy
    BasePerceptionStrategy <|-- VideoPerceptionStrategy
    LLMReporterNode *-- BasePerceptionStrategy

    class RecursiveSummarizer {
        +ollama_url: str
        +max_words: int
        +count_words(text)
        +summarize_chunk(text)
        +recursive_summarize(text_zones, prompt_func)
    }
    LLMReporterNode *-- RecursiveSummarizer

    %% --- CAMBIOS: NUEVO BLOQUE RAG Y LANGCHAIN ---
    class VectorManager {
        +base_dir: str
        +llm: ChatOllama
        +embeddings: OllamaEmbeddings
        +vector_store: FAISS
        +init_vector_store()
        +add_documents(...)
        +get_conversational_chain()
    }
    LLMReporterNode *-- VectorManager

    class ChatbotWeb {
        +vector_manager: VectorManager
        +main()
    }
    ChatbotWeb *-- VectorManager
    %% ---------------------------------------------

    %% --- BLOQUE EVALUADORES ---
    class BaseEvaluatorNode {
        <<abstract>>
        +ollama_params: OllamaParams
        +run_params: EvaluatorRunParams
        +evaluation_mode: str
        +init_metrics_dict()
        +save_intermediate_answers(data)
    }

    class SystemEvaluatorNode {
        +reporter_logic: LLMReporterNode
        +ragas_evaluator: RagasEvaluator
        +evaluate_callback(req, res)
    }

    class PerceptionEvaluatorNode {
        +vision_cli: Client
        +ragas_evaluator: RagasEvaluator
        +evaluate_callback(req, res)
    }

    %% --- CAMBIO: Falso GoalHandle para aislar la evaluación ---
    class MockGoalHandle {
        +is_cancel_requested: bool
        +publish_feedback(msg)
    }
    SystemEvaluatorNode ..> MockGoalHandle : Usa
    %% ----------------------------------------------------------

    BaseEvaluatorNode <|-- SystemEvaluatorNode
    BaseEvaluatorNode <|-- PerceptionEvaluatorNode
    SystemEvaluatorNode *-- LLMReporterNode
    SystemEvaluatorNode *-- RagasEvaluator

    class RagasEvaluator {
        +evaluator_llm: ChatOllama
        +evaluate_system(...)
        +evaluate_perception(...)
        +generate_answers(...)
    }

    %% --- BLOQUE CAPTURADORES (Template Method) ---
    class BaseCaptureNode {
        <<abstract>>
        +last_image: Image
        +last_pose: Pose
        +accumulated_distance: float
        +current_dir: str
        +odometry_callback(msg)
        +image_callback(msg)
        +save_metadata(file_name)
        +cv_bridge_replacement()
        +process_and_save_capture(cv_image)*
    }

    class PhotosCapturerNode {
        +last_saved_cv_image: cv2
        +is_image_different(cv_image)
        +process_and_save_capture(cv_image)
    }

    class VideoCapturerNode {
        +frame_buffer: list
        +process_and_save_capture(cv_image)
        +save_video_clip()
    }

    BaseCaptureNode <|-- PhotosCapturerNode
    BaseCaptureNode <|-- VideoCapturerNode

    %% --- BLOQUE PERCEPCIÓN ---
    class RagContext {
        +zone_name: str
        +time_str: str
        +expected_activities: str
        +zone_type: str
    }

    %% --- CAMBIOS: Segregación de Interfaces (SOLID) ---
    class BasePositionPerceptionNode {
        <<abstract>>
        +analyze_callback(req, res)
        +process_image(path)*
    }
    
    class BaseVLMPerceptionNode {
        <<abstract>>
        +analyze_callback(req, res)
        +process_image(path, context)*
    }
    
    class YoloPerceptionNode { +model: YOLO }
    class VLMPerceptionNode { +vlm_model: str }
    class VideoPerceptionNode { +sampled_frames: int }
    
    class HybridPerceptionNode { 
        +tracking_memory: dict
        +loaded_models: dict
        +check_path()
    }

    BasePositionPerceptionNode <|-- YoloPerceptionNode
    BaseVLMPerceptionNode <|-- VLMPerceptionNode
    BaseVLMPerceptionNode <|-- VideoPerceptionNode
    BaseVLMPerceptionNode <|-- HybridPerceptionNode
    BaseVLMPerceptionNode ..> RagContext : Recibe
    %% --------------------------------------------------

    %% --- BLOQUE NAVEGACIÓN ---
    %% --- CAMBIO: Eliminado PatrolChatbotNode (sustituido por ChatbotWeb) ---

    class PatrolNode {
        +report_action_client: ActionClient
        +navigate_to_waypoint(...)
        +run_patrol()
    }

    %% --- BLOQUE UTILIDADES (Extraído de imports) ---
    class Utils_Library {
        <<module>>
        +Api_Utils: call_ollama_api(), encode_image()
        +Semantic_Utils: load_semantic_map(), get_zone_name()
        +Rag_Utils: format_context_for_ragas()
        +File_Utils: delete_folder(), clean_orphan_folders()
        +Route_Utils: load_route(), list_to_pose()
        +Terminal_Utils: get_key_non_blocking()
    }

    LLMReporterNode ..> Utils_Library : Usa
    PatrolNode ..> Utils_Library : Usa
